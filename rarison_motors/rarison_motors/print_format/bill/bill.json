 "doctype": "Print Format",
 "font_size": 14,
 "html": "<link href=\"https://fonts.googleapis.com/css?family=Roboto\" rel=\"stylesheet\">\r\n<link href=\"https://fonts.googleapis.com/css?family=Markazi+Text\" rel=\"stylesheet\"> \r\n\r\n\r\n<style>\r\n    .text_wrap{\r\n        width: 1%;\r\n        white-space: nowrap;\r\n    }\r\n    \r\n    header-html { \r\n        position: relative;\r\n    }\r\n\r\n    .print-format th {\r\n        padding-top: 1px !important;\r\n        padding-right: 1px !important;\r\n        padding-left: 1px !important;\r\n        padding-bottom: 0px !important;\r\n        background-color:  rgba(0,0,0,0.0) !important;\r\n        vertical-align: middle !important;\r\n        text-align: center;\r\n    }\r\n    \r\n    .print-format td {\r\n        padding-top: 1px !important;\r\n        padding-right: 1px !important;\r\n        padding-left: 1px !important;\r\n        padding-bottom: 0px !important;\r\n        background-color:  rgba(0,0,0,0.0) !important;\r\n        vertical-align: middle !important;\r\n    }\r\n    \r\n\r\n    \r\n    .topborder{\r\n        border-top: 1px solid black !important;\r\n    }\r\n    \r\n    .grandtotaltable{\r\n        max-width: 18mm;\r\n        min-width: 18mm;\r\n        text-align: center;\r\n    }\r\n    \r\n    .unittable{\r\n        max-width: 15mm;\r\n        min-width: 15mm;\r\n        text-align: center;\r\n    }\r\n    \r\n    .qtytable{\r\n        max-width: 10mm;\r\n        min-width: 10mm;\r\n        text-align: center;\r\n    }\r\n    \r\n    .desctable{\r\n        max-width: 78.5mm;\r\n        min-width: 78.5mm;\r\n        text-align: center;\r\n    }\r\n    \r\n    .itemnonotable{\r\n        max-width: 19mm;\r\n        min-width: 19mm;\r\n        text-align: center;\r\n    }\r\n    \r\n    .slnotable{\r\n        max-width: 15mm;\r\n        min-width: 15mm;\r\n        text-align: center;\r\n    }\r\n    \r\n\r\n    .minimumheight{\r\n        height:25px;\r\n        overflow:hidden\r\n    }\r\n    .tblrw1{\r\n        padding-top: 0px !important;\r\n    }\r\n    \r\n    .fntcrr{\r\n        font-family: 'Roboto', 'Markazi Text', sans-serif;\r\n    }\r\n    \r\n    .print-format .tabi{\r\n        padding: 0px;\r\n        margin-top: 0px;\r\n        display: block;\r\n    }\r\n    \r\n    .print-format .bord{\r\n        border: 1px solid black;\r\n    }\r\n    \r\n    .print-format .bbor{\r\n        border-bottom: 2px solid black !important;\r\n        background-color: transparent !important;\r\n    }\r\n    \r\n    .print-format .lbor{\r\n        border-right: 1px solid black;\r\n    }\r\n    \r\n    @media screen {\r\n        .print-format {\r\n    \t\tpadding:8mm;\r\n    \t}\r\n    }\r\n\r\n    .invoice-summary {\r\n        width: 100%;\r\n        margin-top: 3mm;\r\n        border-top: 1px solid #000;\r\n        padding-top: 3mm;\r\n        font-family: 'Roboto', 'Markazi Text', sans-serif;\r\n        font-size: 9pt;\r\n    }\r\n\r\n    .invoice-summary-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .invoice-summary-table > tbody > tr > td {\r\n        padding: 1.5mm 2mm !important;\r\n        vertical-align: bottom !important;\r\n    }\r\n\r\n    .amount-words {\r\n        width: 60%;\r\n        vertical-align: bottom !important;\r\n        padding-right: 5mm !important;\r\n    }\r\n\r\n    .amount-words-title {\r\n        font-weight: bold;\r\n        margin-bottom: 2mm;\r\n    }\r\n\r\n    .amount-words-value {\r\n        line-height: 1.4;\r\n    }\r\n\r\n    .totals-box {\r\n        width: 40%;\r\n        padding: 0 !important;\r\n        vertical-align: bottom !important;\r\n    }\r\n\r\n    .totals-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .totals-table td {\r\n        border: 1px solid #000;\r\n        padding: 2mm 3mm !important;\r\n    }\r\n\r\n    .totals-label {\r\n        text-align: left;\r\n    }\r\n\r\n    .totals-value {\r\n        text-align: right;\r\n    }\r\n\r\n    .grand-total td {\r\n        font-weight: bold;\r\n        font-size: 10pt;\r\n    }\r\n</style>\r\n\r\n<style>\r\n    .upi-qr {\r\n        margin-top: 4mm;\r\n        width: 30mm;\r\n        text-align: center;\r\n    }\r\n\r\n    .upi-qr-title {\r\n        font-weight: bold;\r\n        font-size: 9pt;\r\n        margin-bottom: 2mm;\r\n        text-align: center;\r\n        white-space: nowrap;\r\n    }\r\n\r\n    .upi-qr img {\r\n        width: 30mm !important;\r\n        height: 30mm !important;\r\n        max-width: 30mm !important;\r\n        max-height: 30mm !important;\r\n        object-fit: contain !important;\r\n        display: block !important;\r\n        margin: 0 !important;\r\n    }\r\n</style>\r\n\r\n{% if letter_head and not no_letterhead %}\r\n\r\n<div id=\"header-html\" class=\"hidden-pdf\">\r\n    {%- macro add_header(page_num, max_pages, doc, letter_head, no_letterhead) -%}\r\n        {% if letter_head and not no_letterhead %}\r\n        <div class=\"letter-head\">{{ letter_head }}<br></div>\r\n        {% endif %}\r\n    {%- endmacro -%}\r\n    {{ add_header(0,1,doc,letter_head, no_letterhead) }}\r\n\r\n    <div style=\"text-align:center; font-weight:bold; font-size:11pt; margin:0mm 0 0mm 0;\">\r\n        INVOICE\r\n    </div>\r\n    <div style=\"font-size: 9pt; font-family: 'Roboto', 'Markazi Text', 'sans-serif'; font-weight: 400;  margin:0mm 0 0mm 0;\"  >\r\n        <br>\r\n        <table style=\"width:100%;\">\r\n            <tr class=\"text_wrap\">\r\n                <td style=\"width:28mm;\">Invoice No </td>\r\n                <td style=\"width:1mm;\">:</td>\r\n                <td >{{doc.name}}</td>\r\n            </tr>\r\n            <tr class=\"text_wrap\">\r\n                <td style=\"width:28mm;\">Date</td>\r\n                <td style=\"width:1mm;\">:</td>\r\n                <td>{{frappe.utils.get_datetime(doc.date_in).strftime('%d - %m - %Y') }}</td>\r\n            </tr>\r\n            <tr class=\"text_wrap\">\r\n                <td style=\"width:28mm;\">Customer </td>\r\n                <td style=\"width:1mm;\">:</td>\r\n                <td >{{doc.customer}}</td>\r\n            </tr>\r\n            <tr class=\"text_wrap\">\r\n                <td style=\"width:28mm;\">Vehicle </td>\r\n                <td style=\"width:1mm;\">:</td>\r\n                <td >{{doc.vehicle}}</td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n</div>\r\n\r\n{% endif %}\r\n<div class=\"main-body\">\r\n    <div style=\"text-align:center; font-weight:bold; font-size:9pt; margin:0mm 0 2mm 0;\">\r\n    SPARES\r\n    </div>\r\n\r\n    <div class=\"fntcrr\" >\r\n        <div class=\"tabi\" >\r\n            <table class=\"bord tbd topborder\" border=\"1\" style=\"width:100%; table-layout:fixed;\">\r\n                <thead >\r\n                    <tr height=\"21mm\">\r\n                        <th class=\"lbor bbor slnotable\" style=\"width:10%;\">Sl No.</th>\r\n                        <th class=\"lbor bbor itemnonotable\" style=\"width:18%;\">Item Code</th>\r\n                        <th class=\"lbor bbor desctable\" style=\"width:42%;\">Description</th>\r\n                        <th class=\"lbor bbor qtytable\" style=\"width:10%;\">Qty</th>\r\n                        <th class=\"lbor bbor unittable\" style=\"width:10%;\">Rate</th>\r\n                        <th class=\"lbor bbor grandtotaltable\" style=\"width:10%;\">Total</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    {%- for row in doc.spares_used -%}\r\n                    <tr class=\"tblrw1\" style=\"text-align:center !important;\">\r\n                        <td class=\"lbor minimumheight\">{{ loop.index }} </td>\r\n                        <td class=\"lbor minimumheight\">{{ row.item }}</td>\r\n                        <td class=\"lbor minimumheight\" style=\"text-align:left !important; padding-left:5px !important;\">{{ row.name1 }} <br> </td>\r\n                        <td class=\"lbor minimumheight\">{{ row.qty }}</td>\r\n                        <td class=\"lbor minimumheight\"> {{ \"%.2f\"|format(row.rate) }}</td>\r\n                        <td class=\"lbor minimumheight\"> {{ \"%.2f\"|format( row.total) }}</td>\r\n                    </tr>\r\n                    {%- endfor -%}\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n        <br>\r\n    </div>\r\n    <div style=\"text-align:center; font-weight:bold; font-size:9pt; margin:3mm 0 2mm 0;\">\r\n        LABOUR\r\n    </div>\r\n    <div class=\"fntcrr\" >\r\n        <div class=\"tabi\" >\r\n            <table class=\"bord tbd topborder\" border=\"1\" style=\"width:100%; table-layout:fixed;\">\r\n                <thead >\r\n                    <tr height=\"21mm\">\r\n                        <th class=\"lbor bbor slnotable\" style=\"width:10%;\">Sl No.</th>\r\n                        <th class=\"lbor bbor itemnonotable\" style=\"width:18%;\">Item Code</th>\r\n                        <th class=\"lbor bbor desctable\" style=\"width:42%;\">Description</th>\r\n                        <th class=\"lbor bbor qtytable\" style=\"width:10%;\">Qty</th>\r\n                        <th class=\"lbor bbor unittable\" style=\"width:10%;\">Rate</th>\r\n                        <th class=\"lbor bbor grandtotaltable\" style=\"width:10%;\">Total</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    {%- for row in doc.labour_work_done -%}\r\n                    <tr class=\"tblrw1\" style=\"text-align:center !important;\">\r\n                        <td class=\"lbor minimumheight\">{{ loop.index }} </td>\r\n                        <td class=\"lbor minimumheight\">{{ row.repair }}</td>\r\n                        <td class=\"lbor minimumheight\" style=\"text-align:left !important; padding-left:5px !important;\">{{ row.name1 }} <br> </td>\r\n                        <td class=\"lbor minimumheight\">{{ row.qty }}</td>\r\n                        <td class=\"lbor minimumheight\"> {{ \"%.2f\"|format(row.rate) }}</td>\r\n                        <td class=\"lbor minimumheight\"> {{ \"%.2f\"|format( row.total) }}</td>\r\n                    </tr>\r\n                    {%- endfor -%}\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n        <br>\r\n    </div>\r\n\r\n    <div class=\"invoice-summary\">\r\n        <table class=\"invoice-summary-table\">\r\n            <tr>\r\n                <!-- Pay using UPI -->\r\n                <td class=\"amount-words\">\r\n                <div class=\"upi-qr\">\r\n                        <div class=\"upi-qr-title\">\r\n                            Pay using UPI\r\n                        </div>\r\n                        <img src=\"{{ generate_upi_qr(\r\n                            doc.rounded_total or doc.amount_after_discount or 0,\r\n                            doc.name\r\n                        ) }}\">\r\n                    </div>\r\n                </td>\r\n                <!-- TOTALS -->\r\n                <td class=\"totals-box\">\r\n                    <table class=\"totals-table\">\r\n                        <tr>\r\n                            <td class=\"totals-label\">\r\n                                Spares Total\r\n                            </td>\r\n                            <td class=\"totals-value\">\r\n                                {{ \"%.2f\"|format(doc.spare_total) }}\r\n                            </td>\r\n                        </tr>\r\n\r\n                        <tr>\r\n                            <td class=\"totals-label\">\r\n                                Labour Total\r\n                            </td>\r\n                            <td class=\"totals-value\">\r\n                                {{ \"%.2f\"|format(doc.labour_total) }}\r\n                            </td>\r\n                        </tr>\r\n\r\n                        {% if doc.discount_amount > 0 %}\r\n                            <tr>\r\n                                <td class=\"totals-label\">\r\n                                    Discount\r\n                                </td>\r\n                                <td class=\"totals-value\">\r\n                                    {{ \"%.2f\"|format(doc.discount_amount) }}\r\n                                </td>\r\n                            </tr>\r\n                        {% endif %}\r\n\r\n                        <tr class=\"grand-total\">\r\n                            <td class=\"totals-label\">\r\n                                Grand Total\r\n                            </td>\r\n                            <td class=\"totals-value\">\r\n                                {{ \"%.2f\"|format(\r\n                                    doc.rounded_total or\r\n                                    doc.amount_after_discount or\r\n                                    0\r\n                                ) }}\r\n                            </td>\r\n                        </tr>\r\n\r\n                    </table>\r\n\r\n                </td>\r\n\r\n            </tr>\r\n            <tr>\r\n                <td>\r\n                    <div class=\"amount-words-title\">\r\n                        Amount in Words: {{ frappe.utils.money_in_words(\r\n                            doc.rounded_total or doc.amount_after_discount or 0\r\n                        ) }}\r\n                    </div>\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n</div>\r\n\r\n<div id=\"footer-html\" class=\"visible-pdf\">\r\n    {% if footer and not no_letterhead %}\r\n        <div id=\"htmlfooter\">\r\n            {{ footer }}\r\n        </div>\r\n    {% endif %}\r\n</div>",
